{
  "components": {
    "schemas": {
      "AskResponse": {
        "additionalProperties": false,
        "properties": {
          "answer": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Answer"
          },
          "claims": {
            "items": {
              "$ref": "#/components/schemas/VerifiedClaim"
            },
            "title": "Claims",
            "type": "array"
          },
          "error_kind": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Kind"
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/PublicEvidence"
            },
            "title": "Evidence",
            "type": "array"
          },
          "limitations": {
            "items": {
              "type": "string"
            },
            "title": "Limitations",
            "type": "array"
          },
          "reason_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason Code"
          },
          "status": {
            "$ref": "#/components/schemas/ResponseStatus"
          },
          "trace_id": {
            "title": "Trace Id",
            "type": "string"
          },
          "validation": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ValidationReport"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "status",
          "trace_id"
        ],
        "title": "AskResponse",
        "type": "object"
      },
      "ClaimSupport": {
        "additionalProperties": false,
        "properties": {
          "evidence_id": {
            "minLength": 1,
            "title": "Evidence Id",
            "type": "string"
          },
          "quote": {
            "maxLength": 500,
            "minLength": 1,
            "title": "Quote",
            "type": "string"
          }
        },
        "required": [
          "evidence_id",
          "quote"
        ],
        "title": "ClaimSupport",
        "type": "object"
      },
      "ErrorEnvelope": {
        "additionalProperties": false,
        "properties": {
          "error_kind": {
            "title": "Error Kind",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "retryable": {
            "default": false,
            "title": "Retryable",
            "type": "boolean"
          },
          "trace_id": {
            "title": "Trace Id",
            "type": "string"
          }
        },
        "required": [
          "trace_id",
          "error_kind",
          "message"
        ],
        "title": "ErrorEnvelope",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "additionalProperties": false,
        "properties": {
          "chunk_count": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Chunk Count"
          },
          "corpus_ready": {
            "title": "Corpus Ready",
            "type": "boolean"
          },
          "corpus_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Corpus Version"
          },
          "index_ready": {
            "title": "Index Ready",
            "type": "boolean"
          },
          "problems": {
            "items": {
              "type": "string"
            },
            "title": "Problems",
            "type": "array"
          },
          "provider_configured": {
            "title": "Provider Configured",
            "type": "boolean"
          },
          "status": {
            "enum": [
              "ready",
              "not_ready"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "corpus_ready",
          "index_ready",
          "provider_configured"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "LivenessResponse": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "const": "alive",
            "default": "alive",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "LivenessResponse",
        "type": "object"
      },
      "PublicEvidence": {
        "additionalProperties": false,
        "properties": {
          "canonical_url": {
            "format": "uri",
            "maxLength": 2083,
            "minLength": 1,
            "title": "Canonical Url",
            "type": "string"
          },
          "context_text": {
            "title": "Context Text",
            "type": "string"
          },
          "evidence_id": {
            "title": "Evidence Id",
            "type": "string"
          },
          "locator": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Locator"
          },
          "primary_text": {
            "title": "Primary Text",
            "type": "string"
          },
          "publisher": {
            "title": "Publisher",
            "type": "string"
          },
          "temporal_class": {
            "const": "stable_guidance",
            "title": "Temporal Class",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "evidence_id",
          "title",
          "publisher",
          "canonical_url",
          "locator",
          "temporal_class",
          "primary_text",
          "context_text"
        ],
        "title": "PublicEvidence",
        "type": "object"
      },
      "QueryRequest": {
        "additionalProperties": false,
        "properties": {
          "question": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Question",
            "type": "string"
          }
        },
        "required": [
          "question"
        ],
        "title": "QueryRequest",
        "type": "object"
      },
      "ResponseStatus": {
        "enum": [
          "answer",
          "abstention",
          "error"
        ],
        "title": "ResponseStatus",
        "type": "string"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "ValidationReport": {
        "additionalProperties": false,
        "properties": {
          "accepted": {
            "title": "Accepted",
            "type": "boolean"
          },
          "citation_ids_valid": {
            "title": "Citation Ids Valid",
            "type": "boolean"
          },
          "errors": {
            "items": {
              "type": "string"
            },
            "title": "Errors",
            "type": "array"
          },
          "policy_valid": {
            "title": "Policy Valid",
            "type": "boolean"
          },
          "quotes_exact": {
            "title": "Quotes Exact",
            "type": "boolean"
          },
          "schema_valid": {
            "default": true,
            "title": "Schema Valid",
            "type": "boolean"
          }
        },
        "required": [
          "accepted",
          "citation_ids_valid",
          "quotes_exact",
          "policy_valid"
        ],
        "title": "ValidationReport",
        "type": "object"
      },
      "VerifiedClaim": {
        "additionalProperties": false,
        "properties": {
          "claim_id": {
            "pattern": "^C[1-9][0-9]*$",
            "title": "Claim Id",
            "type": "string"
          },
          "supports": {
            "items": {
              "$ref": "#/components/schemas/ClaimSupport"
            },
            "maxItems": 5,
            "minItems": 1,
            "title": "Supports",
            "type": "array"
          },
          "text": {
            "maxLength": 600,
            "minLength": 1,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "claim_id",
          "text",
          "supports"
        ],
        "title": "VerifiedClaim",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Evidence-bound stable wildfire guidance; not current status.",
    "title": "FireLens BC Static RAG",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/ask": {
      "post": {
        "operationId": "ask_api_v1_ask_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QueryRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AskResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Bad Request"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Internal Server Error"
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Bad Gateway"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Ask"
      }
    },
    "/api/v1/health/live": {
      "get": {
        "operationId": "liveness_api_v1_health_live_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LivenessResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Liveness"
      }
    },
    "/api/v1/health/ready": {
      "get": {
        "operationId": "readiness_api_v1_health_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Readiness"
      }
    }
  }
}
