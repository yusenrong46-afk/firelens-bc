{
  "components": {
    "schemas": {
      "AskResponse": {
        "additionalProperties": false,
        "properties": {
          "answer": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Answer"
          },
          "claims": {
            "items": {
              "$ref": "#/components/schemas/PublicClaim"
            },
            "title": "Claims",
            "type": "array"
          },
          "error_kind": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Kind"
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/PublicEvidence"
            },
            "title": "Evidence",
            "type": "array"
          },
          "limitations": {
            "items": {
              "type": "string"
            },
            "title": "Limitations",
            "type": "array"
          },
          "live_results": {
            "items": {
              "$ref": "#/components/schemas/LiveResult"
            },
            "title": "Live Results",
            "type": "array"
          },
          "reason_code": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ReasonCode"
              },
              {
                "type": "null"
              }
            ]
          },
          "response_mode": {
            "$ref": "#/components/schemas/ResponseMode",
            "default": "abstention"
          },
          "status": {
            "$ref": "#/components/schemas/ResponseStatus"
          },
          "suggested_questions": {
            "items": {
              "type": "string"
            },
            "maxItems": 6,
            "title": "Suggested Questions",
            "type": "array"
          },
          "trace_id": {
            "title": "Trace Id",
            "type": "string"
          },
          "unavailable_layers": {
            "items": {
              "$ref": "#/components/schemas/LiveResultKind"
            },
            "title": "Unavailable Layers",
            "type": "array"
          },
          "validation": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ValidationReport"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "status",
          "trace_id"
        ],
        "title": "AskResponse",
        "type": "object"
      },
      "ClaimSupport": {
        "additionalProperties": false,
        "properties": {
          "evidence_id": {
            "minLength": 1,
            "title": "Evidence Id",
            "type": "string"
          },
          "quote": {
            "maxLength": 500,
            "minLength": 1,
            "title": "Quote",
            "type": "string"
          }
        },
        "required": [
          "evidence_id",
          "quote"
        ],
        "title": "ClaimSupport",
        "type": "object"
      },
      "ConversationTurn": {
        "additionalProperties": false,
        "properties": {
          "content": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Content",
            "type": "string"
          },
          "role": {
            "enum": [
              "user",
              "assistant"
            ],
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "role",
          "content"
        ],
        "title": "ConversationTurn",
        "type": "object"
      },
      "ErrorEnvelope": {
        "additionalProperties": false,
        "properties": {
          "error_kind": {
            "title": "Error Kind",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "retryable": {
            "default": false,
            "title": "Retryable",
            "type": "boolean"
          },
          "trace_id": {
            "title": "Trace Id",
            "type": "string"
          }
        },
        "required": [
          "trace_id",
          "error_kind",
          "message"
        ],
        "title": "ErrorEnvelope",
        "type": "object"
      },
      "EvidenceStatus": {
        "enum": [
          "verified_corpus",
          "general_background"
        ],
        "title": "EvidenceStatus",
        "type": "string"
      },
      "Freshness": {
        "enum": [
          "fresh",
          "stale"
        ],
        "title": "Freshness",
        "type": "string"
      },
      "GeometryRelation": {
        "enum": [
          "inside",
          "nearby",
          "outside",
          "unknown"
        ],
        "title": "GeometryRelation",
        "type": "string"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "additionalProperties": false,
        "properties": {
          "build_commit": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Build Commit"
          },
          "chunk_count": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Chunk Count"
          },
          "corpus_ready": {
            "title": "Corpus Ready",
            "type": "boolean"
          },
          "corpus_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Corpus Version"
          },
          "deployment_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Deployment Id"
          },
          "index_ready": {
            "title": "Index Ready",
            "type": "boolean"
          },
          "problems": {
            "items": {
              "type": "string"
            },
            "title": "Problems",
            "type": "array"
          },
          "provider_configured": {
            "title": "Provider Configured",
            "type": "boolean"
          },
          "rate_limit_scope": {
            "const": "instance_local",
            "default": "instance_local",
            "title": "Rate Limit Scope",
            "type": "string"
          },
          "release_version": {
            "title": "Release Version",
            "type": "string"
          },
          "status": {
            "enum": [
              "ready",
              "not_ready"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "corpus_ready",
          "index_ready",
          "provider_configured",
          "release_version"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "LiveMapResponse": {
        "additionalProperties": false,
        "properties": {
          "generated_at": {
            "format": "date-time",
            "title": "Generated At",
            "type": "string"
          },
          "limitations": {
            "items": {
              "type": "string"
            },
            "title": "Limitations",
            "type": "array"
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/LiveResult"
            },
            "title": "Results",
            "type": "array"
          },
          "unavailable_layers": {
            "items": {
              "$ref": "#/components/schemas/LiveResultKind"
            },
            "title": "Unavailable Layers",
            "type": "array"
          }
        },
        "required": [
          "generated_at",
          "results"
        ],
        "title": "LiveMapResponse",
        "type": "object"
      },
      "LiveResult": {
        "additionalProperties": false,
        "properties": {
          "authority": {
            "default": "BC Wildfire Service",
            "title": "Authority",
            "type": "string"
          },
          "freshness": {
            "$ref": "#/components/schemas/Freshness"
          },
          "geometry": {
            "additionalProperties": true,
            "title": "Geometry",
            "type": "object"
          },
          "geometry_relation": {
            "$ref": "#/components/schemas/GeometryRelation",
            "default": "unknown"
          },
          "incident_number": {
            "anyOf": [
              {
                "maxLength": 100,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Incident Number"
          },
          "issuer": {
            "anyOf": [
              {
                "maxLength": 300,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Issuer"
          },
          "kind": {
            "$ref": "#/components/schemas/LiveResultKind"
          },
          "name": {
            "anyOf": [
              {
                "maxLength": 300,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "result_id": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Result Id",
            "type": "string"
          },
          "retrieved_at": {
            "format": "date-time",
            "title": "Retrieved At",
            "type": "string"
          },
          "size_hectares": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Size Hectares"
          },
          "source_updated_at": {
            "format": "date-time",
            "title": "Source Updated At",
            "type": "string"
          },
          "source_url": {
            "format": "uri",
            "maxLength": 2083,
            "minLength": 1,
            "title": "Source Url",
            "type": "string"
          },
          "status": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "result_id",
          "kind",
          "source_url",
          "source_updated_at",
          "retrieved_at",
          "freshness",
          "status",
          "geometry"
        ],
        "title": "LiveResult",
        "type": "object"
      },
      "LiveResultKind": {
        "enum": [
          "incident",
          "perimeter",
          "evacuation"
        ],
        "title": "LiveResultKind",
        "type": "string"
      },
      "LivenessResponse": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "const": "alive",
            "default": "alive",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "LivenessResponse",
        "type": "object"
      },
      "LocationInput": {
        "additionalProperties": false,
        "description": "Coarse, opt-in location used only for the current live-data request.",
        "properties": {
          "label": {
            "anyOf": [
              {
                "maxLength": 120,
                "minLength": 2,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Label"
          },
          "latitude": {
            "anyOf": [
              {
                "maximum": 61.0,
                "minimum": 48.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latitude"
          },
          "longitude": {
            "anyOf": [
              {
                "maximum": -113.0,
                "minimum": -140.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Longitude"
          },
          "radius_km": {
            "default": 50.0,
            "maximum": 200.0,
            "minimum": 1.0,
            "title": "Radius Km",
            "type": "number"
          }
        },
        "title": "LocationInput",
        "type": "object"
      },
      "PublicClaim": {
        "additionalProperties": false,
        "properties": {
          "claim_id": {
            "pattern": "^C[1-9][0-9]*$",
            "title": "Claim Id",
            "type": "string"
          },
          "evidence_status": {
            "$ref": "#/components/schemas/EvidenceStatus"
          },
          "supports": {
            "items": {
              "$ref": "#/components/schemas/ClaimSupport"
            },
            "maxItems": 5,
            "title": "Supports",
            "type": "array"
          },
          "text": {
            "maxLength": 600,
            "minLength": 1,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "claim_id",
          "text",
          "evidence_status"
        ],
        "title": "PublicClaim",
        "type": "object"
      },
      "PublicEvidence": {
        "additionalProperties": false,
        "properties": {
          "canonical_url": {
            "format": "uri",
            "maxLength": 2083,
            "minLength": 1,
            "title": "Canonical Url",
            "type": "string"
          },
          "context_text": {
            "title": "Context Text",
            "type": "string"
          },
          "evidence_id": {
            "title": "Evidence Id",
            "type": "string"
          },
          "locator": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Locator"
          },
          "primary_text": {
            "title": "Primary Text",
            "type": "string"
          },
          "publisher": {
            "title": "Publisher",
            "type": "string"
          },
          "temporal_class": {
            "const": "stable_guidance",
            "title": "Temporal Class",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "evidence_id",
          "title",
          "publisher",
          "canonical_url",
          "locator",
          "temporal_class",
          "primary_text",
          "context_text"
        ],
        "title": "PublicEvidence",
        "type": "object"
      },
      "QueryRequest": {
        "additionalProperties": false,
        "properties": {
          "history": {
            "items": {
              "$ref": "#/components/schemas/ConversationTurn"
            },
            "maxItems": 6,
            "title": "History",
            "type": "array"
          },
          "location": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/LocationInput"
              },
              {
                "type": "null"
              }
            ]
          },
          "question": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Question",
            "type": "string"
          }
        },
        "required": [
          "question"
        ],
        "title": "QueryRequest",
        "type": "object"
      },
      "ReasonCode": {
        "enum": [
          "capability_overview",
          "scope_redirect",
          "personalized_safety_decision",
          "personalized_medical_advice",
          "policy_manipulation",
          "live_data_required",
          "planning_unavailable",
          "retrieval_unavailable",
          "retrieval_incomplete",
          "no_approved_evidence",
          "wrong_temporal_class",
          "required_authority_missing",
          "approved_static_evidence",
          "generation_unavailable",
          "draft_validation_failed",
          "model_abstained"
        ],
        "title": "ReasonCode",
        "type": "string"
      },
      "ResponseMode": {
        "enum": [
          "grounded",
          "background",
          "capability",
          "scope_redirect",
          "abstention",
          "partial",
          "live",
          "mixed"
        ],
        "title": "ResponseMode",
        "type": "string"
      },
      "ResponseStatus": {
        "enum": [
          "answer",
          "abstention",
          "error"
        ],
        "title": "ResponseStatus",
        "type": "string"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "ValidationReport": {
        "additionalProperties": false,
        "properties": {
          "accepted": {
            "title": "Accepted",
            "type": "boolean"
          },
          "citation_ids_valid": {
            "title": "Citation Ids Valid",
            "type": "boolean"
          },
          "errors": {
            "items": {
              "type": "string"
            },
            "title": "Errors",
            "type": "array"
          },
          "policy_valid": {
            "title": "Policy Valid",
            "type": "boolean"
          },
          "quotes_exact": {
            "title": "Quotes Exact",
            "type": "boolean"
          },
          "schema_valid": {
            "default": true,
            "title": "Schema Valid",
            "type": "boolean"
          }
        },
        "required": [
          "accepted",
          "citation_ids_valid",
          "quotes_exact",
          "policy_valid"
        ],
        "title": "ValidationReport",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Evidence-bound wildfire guidance plus bounded official incident, perimeter, and evacuation records. Not emergency direction.",
    "title": "FireLens BC",
    "version": "1.5.0-rc.1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/ask": {
      "post": {
        "operationId": "ask_api_v1_ask_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QueryRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AskResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Bad Request"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Not Found"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Content Too Large"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Too Many Requests"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Internal Server Error"
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Bad Gateway"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Ask"
      }
    },
    "/api/v1/health/live": {
      "get": {
        "operationId": "liveness_api_v1_health_live_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LivenessResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Liveness"
      }
    },
    "/api/v1/health/ready": {
      "get": {
        "operationId": "readiness_api_v1_health_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Readiness"
      }
    },
    "/api/v1/live/map": {
      "get": {
        "operationId": "live_map_api_v1_live_map_get",
        "parameters": [
          {
            "in": "query",
            "name": "bbox",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 100,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Bbox"
            }
          },
          {
            "in": "query",
            "name": "layers",
            "required": false,
            "schema": {
              "default": "incidents,perimeters,evacuations",
              "maxLength": 100,
              "title": "Layers",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LiveMapResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Live Map"
      }
    }
  }
}
