{
  "name": "firelens-rag-ui",
  "version": "1.6.0-rc.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate:api": "openapi-typescript ../../docs/openapi.v1.json -o src/shared/api/api-schema.d.ts",
    "setup:browsers": "playwright install chromium",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:real": "playwright test --config=playwright.real.config.ts",
    "test:tooling": "node --test tests/tooling-config.test.mjs",
    "test:surface": "node --test tests/frontend-surface-runner.test.mjs",
    "qualify:surface": "npm run build && node scripts/qualify-frontend-surface.mjs",
    "build": "npm run typecheck && vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test:sites": "npm run build && node --test tests/sites-worker.test.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "leaflet": "^1.9.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-leaflet": "^5.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "vite": "6.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/leaflet": "^1.9.21",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "axe-core": "^4.12.1",
    "brace-expansion": "5.0.9",
    "jsdom": "^29.1.1",
    "js-yaml": "4.3.1",
    "nanoid": "3.3.18",
    "openapi-typescript": "^7.13.0",
    "sharp": "^0.35.3",
    "typescript": "5.9.3",
    "vitest": "^4.1.10",
    "vitest-axe": "^0.1.0"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "js-yaml": "4.3.1",
    "minimatch": "10.2.6",
    "nanoid": "3.3.18",
    "postcss": "8.5.25"
  }
}
