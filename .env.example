# Copy to .env and keep the real value local. Never commit API keys.
OPENROUTER_API_KEY=
FIRELENS_EMBEDDING_MODEL=openai/text-embedding-3-small
FIRELENS_RERANK_MODEL=cohere/rerank-4-pro
FIRELENS_GENERATION_MODEL=openai/gpt-5.6-luna
FIRELENS_RELEASE_VERSION=1.5.3-rc.1

# Runtime controls. Local defaults keep ZDR optional so unpaid development can
# start. Production must set embedding and generation ZDR to required. Reranking
# may stay optional for the retrieval-qualified Cohere reranker. Every OpenRouter
# request still sends data_collection=deny, allow_fallbacks=false, and
# require_parameters=true. FIRELENS_REQUIRE_ZDR remains a migration shim:
# true alone selects the approved mix; false alone keeps all stages optional;
# contradictory combinations with the stage variables are rejected.
FIRELENS_EMBEDDING_ZDR=optional
FIRELENS_RERANKING_ZDR=optional
FIRELENS_GENERATION_ZDR=optional
FIRELENS_DATA_COLLECTION=deny
FIRELENS_ALLOW_FALLBACKS=false
# FIRELENS_REQUIRE_ZDR=false
FIRELENS_DEBUG=false
FIRELENS_TRACE_CONTENT=false
FIRELENS_RATE_LIMIT=30
FIRELENS_RATE_WINDOW_SECONDS=60
FIRELENS_MAX_REQUEST_BODY_BYTES=65536
FIRELENS_PUBLIC_REQUEST_DEADLINE_SECONDS=45
FIRELENS_PROVIDER_MAX_CONCURRENCY=4
FIRELENS_PROVIDER_ADAPTIVE_MIN_CONCURRENCY=1
FIRELENS_PROVIDER_ADAPTIVE_SUCCESS_WINDOW=20

# Optional writable runtime trace location for serverless hosts.
# FIRELENS_TRACE_DIR=/tmp/firelens-traces
