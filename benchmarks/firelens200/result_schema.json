{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "firelens200.result.v1",
  "title": "FireLens-200 result row",
  "type": "object",
  "required": ["case_id", "split", "run_number", "status", "candidate_commit"],
  "properties": {
    "case_id": { "type": "string" },
    "split": { "type": "string" },
    "category": { "type": ["string", "null"] },
    "oracle_type": { "type": ["string", "null"] },
    "difficulty": { "type": ["string", "null"] },
    "run_number": { "type": "integer" },
    "repeat_count": { "type": ["integer", "null"] },
    "critical_repeat": { "type": ["boolean", "null"] },
    "equivalence_group": { "type": ["string", "null"] },
    "question": { "type": ["string", "null"] },
    "context": { "type": "array", "items": { "type": "string" } },
    "gold_answer_or_rule": { "type": ["string", "null"] },
    "must_include": { "type": "array", "items": { "type": "string" } },
    "must_not_include": { "type": "array", "items": { "type": "string" } },
    "candidate_commit": { "type": "string" },
    "deployment_id": { "type": ["string", "null"] },
    "provider_model": { "type": ["string", "null"] },
    "http_status": { "type": ["integer", "null"] },
    "error": { "type": ["string", "null"] },
    "visible_answer": { "type": ["string", "null"] },
    "response_mode": { "type": ["string", "null"] },
    "reason_code": { "type": ["string", "null"] },
    "provenance_class": { "type": ["string", "null"] },
    "presentation_shell": { "type": ["string", "null"] },
    "source_lane": { "type": ["string", "null"] },
    "primary_record_ids": { "type": "array", "items": { "type": "string" } },
    "map_primary_ids": { "type": "array", "items": { "type": "string" } },
    "table_primary_ids": { "type": "array", "items": { "type": "string" } },
    "sample_record_ids": { "type": "array", "items": { "type": "string" } },
    "roster_total": { "type": ["integer", "null"] },
    "evidence_ids": { "type": "array" },
    "limitations": { "type": "array" },
    "suggestions": { "type": "array" },
    "related_links": { "type": "array" },
    "latency_ms": { "type": ["number", "null"] },
    "token_usage": { "type": ["object", "null"] },
    "cost": { "type": ["number", "null"] },
    "oracle": { "type": "object" },
    "deterministic_checks": { "type": "object" },
    "hard_failures": { "type": "array", "items": { "type": "string" } },
    "judge": { "type": "object" },
    "cursor_feedback": { "type": "object" },
    "status": {
      "type": "string",
      "enum": ["PASS", "FAIL", "REVIEW", "BLOCKED", "NOT_RUN"]
    },
    "not_run_reason": { "type": ["string", "null"] },
    "raw_response_path": { "type": ["string", "null"] },
    "screenshot_path": { "type": ["string", "null"] },
    "started_at": { "type": ["string", "null"] },
    "finished_at": { "type": ["string", "null"] },
    "structured_result_hash": { "type": ["string", "null"] }
  }
}
